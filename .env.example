# LiveKit project credentials (same project the Python agent connects to)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Must match the AGENT_NAME env of the running intervoo agent worker
LIVEKIT_AGENT_NAME=intervoo-agent-dev-2

# LLM used by /api/evaluate (needs a vision-capable model for whiteboard evaluation)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
# LLM used by /api/parse-resume (must accept PDF file input); falls back to OPENROUTER_MODEL
RESUME_MODEL=google/gemini-2.5-flash

# Server-side code execution used by /api/code/run
ONECOMPILER_API_KEY=
