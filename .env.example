# LiveKit project credentials (same project the Python agent connects to)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Must match the AGENT_NAME env of the running intervoo agent worker
LIVEKIT_AGENT_NAME=intervoo-agent-dev-2

# Show resume parsing and adaptive interview plan details in the UI
NEXT_PUBLIC_DEV_DEBUG=false
# backend | frontend | system-design-only
INTERVIEW_QUESTION_MODE=backend

# LLM used by /api/evaluate (needs a vision-capable model for whiteboard evaluation)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
WHITEBOARD_EVALUATION_SIGNING_SECRET=
# Direct browser-to-S3 whiteboard uploads. Keep these server-only.
AWS_S3_BUCKET=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT=
AWS_S3_FORCE_PATH_STYLE=false
S3_BASE_PREFIX=agents
# LLM used by /api/parse-resume (must accept PDF file input); falls back to OPENROUTER_MODEL
RESUME_MODEL=google/gemini-2.5-flash

# Server-side code execution used by /api/code/run
ONECOMPILER_API_KEY=
